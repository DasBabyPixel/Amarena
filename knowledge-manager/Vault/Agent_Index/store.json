ode-Graph, weil das Terrain stark irregulaer ist.\n","metadata":{"metadata":{"ticketId":"AMA-001"}}}},{"id":"63db12f3-5d44-4f87-9ce5-357718c4bbf2","embedding":{"vector":[-0.026499903,0.021122783,-0.025445879,3.0378404E-4,0.0233874,-0.018298129,0.097084604,0.029800111,-0.022502173,0.03931776,0.056632325,0.0038899786,0.031824403,-0.009729693,-0.12310292,-0.009090216,-0.06223679,0.018146126,-0.04621015,-0.016446983,-0.077590644,0.0152739845,-0.009605216,0.08541132,-0.0027051563,-0.032262903,-0.0461115,-0.05490335,0.006329341,-0.0019903416,0.05688816,0.04468687,0.01916504,0.06878988,0.021639962,0.01992537,-0.043929327,-0.058864303,-0.03228918,0.04793871,0.035936255,0.022219023,-0.017351458,-0.058912378,-0.062612794,-0.035656087,0.017020809,-0.012598717,-0.07800815,-0.018755991,-0.013770445,-0.05607423,-0.0036549086,-0.051179554,0.017155996,-0.02743546,-0.031317957,-0.033141494,0.02110768,-0.026422745,0.025934234,0.02027094,-0.066332616,-0.09765996,-0.055570785,-0.005866032,-0.0092303,-0.007403669,0.046844345,0.01970842,0.09483541,7.858353E-4,-0.06756817,0.0031319454,0.044005807,0.09584387,-0.013807801,0.05628249,0.023211103,-0.15488702,0.047669087,-0.049175236,0.017181182,-0.047718763,-0.061174244,0.035669446,0.058213294,0.08214479,0.070249096,-0.03385849,0.020606006,0.020140892,0.05704853,-0.0013855898,0.00883721,-0.042349756,0.0911496,0.02990885,-0.023209335,0.10144025,0.045430113,0.06251164,-0.084325574,0.021934744,-0.044148874,-0.012104242,0.009360934,-0.0075687915,-0.0780645,-0.023137731,0.014825911,-0.04484553,-0.028550943,-0.08512098,-0.016625699,0.099109136,0.10127127,0.01352075,-0.10998356,-0.02435091,0.044368338,-0.04228055,0.020348774,-0.01910473,0.017139021,-1.311352E-4,0.023848929,1.3326544E-32,0.016948186,0.009749743,-0.045079347,-0.015917903,0.0032931059,0.084389955,-0.08945447,-0.045734983,-0.0019423022,-0.04499226,0.019728135,-0.025958655,-0.06094686,-0.06462773,-0.024992405,-0.022564786,0.045864664,-0.013741886,-0.028871194,0.002676101,-0.0064111776,-0